  "query": "select r.id, r.name, p.name as patient_name, r.imported_at\n             from lab_reports r join patients p on p.tenant_id = r.tenant_id and p.id = r.patient_id\n             where r.tenant_id = $1\n             order by r.imported_at desc, r.id desc",
